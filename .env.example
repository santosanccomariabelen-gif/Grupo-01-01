# Configuración local del agente. Copiar a .env, que no se versiona.

# Dominio del equipo: fraud | fees | cards | loans | support
DOMAIN=fraud
# Turnos del historial que se envían al modelo
MAX_TURNS=10

# Microsoft Foundry. Estos valores apuntan al mock local (dev/mock_foundry.py)
FOUNDRY_ENDPOINT=http://127.0.0.1:8100
# Deployment del modelo de chat
FOUNDRY_DEPLOYMENT=gpt-5-mini
# Deployment de embeddings
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Autenticación: api_key (usa FOUNDRY_API_KEY) | entra_id (az login en local, Managed Identity desplegado)
FOUNDRY_AUTH_PROVIDER=api_key
FOUNDRY_API_KEY=fake-token
FOUNDRY_TIMEOUT_S=30
FOUNDRY_MAX_RETRIES=2

# Tamaño máximo de cada chunk en la ingesta
INGEST_CHUNK_MAX_CHARS=1500

# Dónde buscar: local (Qdrant en data/index; solo para desarrollar y en los tests) | azure_search (el índice del equipo
# en Azure AI Search: lo usa el agente desplegado, y el tuyo desde el cierre de la sesión 4)
KNOWLEDGE_BASE=local
# Fragmentos del corpus que recibe el modelo en cada turno
SEARCH_TOP_K=5
# Solo con azure_search. Entra ID con az login, sin keys
SEARCH_ENDPOINT=
SEARCH_INDEX=

# Juez de la evaluación (uv run eval): local (G-Eval con un modelo generativo) | azure_evaluation (Microsoft-Decision-1)
JUDGE=local
# Deployment del juez G-Eval; conviene uno distinto al del chat, para que no se califique a sí mismo
FOUNDRY_JUDGE_DEPLOYMENT=gpt-5-mini
# Deployment de Microsoft-Decision-1
FOUNDRY_DECISION_DEPLOYMENT=microsoft-decision-1
